<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chat Module</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <main class="chat-app">

        <!-- Header -->
        <header class="chat-header">
            <div>
                <p class="eyebrow">MESSAGING</p>
                <h1>Chat Module</h1>
            </div>

            <div class="header-right">
                <div class="chat-status">
                    <span class="status-dot"></span>
                    <span>Active</span>
                </div>

                <form method="GET" action="/chats/new" class="new-chat-form">
                    <button type="submit" class="new-chat-btn">
                        <span class="plus">+</span> New chat
                    </button>
                </form>
            </div>
        </header>


        <!-- Chat Section -->
        <section class="chat-container">

            <div class="section-heading">
                <h2>All chats</h2>
                <span class="chat-count">
                    <%= allChats.length %> conversation<%= allChats.length === 1 ? '' : 's' %>
                </span>
            </div>


            <!-- Chats -->
            <div class="chat-list">

                <% if (allChats.length === 0) { %>

                    <div class="empty-state">
                        <div class="empty-icon">💬</div>
                        <h3>No conversations yet</h3>
                        <p>Start a new chat and it'll show up here.</p>
                        <form method="GET" action="/chats/new">
                            <button type="submit" class="new-chat-btn secondary">
                                <span class="plus">+</span> New chat
                            </button>
                        </form>
                    </div>

                <% } %>


                <% for (let chat of allChats) { %>
                    <%
                        const created = new Date(chat.createdAt);
                        const timeLabel = created.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
                        const dateLabel = created.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    %>

                    <article class="chat-card">

                        <div class="card-top">

                            <!-- User Information -->
                            <div class="user-info">

                                <div class="avatar"><%= chat.from.charAt(0).toUpperCase() %></div>

                                <div class="user-details">
                                    <h3><%= chat.from %></h3>
                                    <span class="to-line">to <%= chat.to %></span>
                                </div>

                            </div>

                            <span class="card-timestamp" title="<%= dateLabel %> · <%= timeLabel %>">
                                <%= timeLabel %>
                            </span>

                        </div>


                        <!-- Message -->
                        <div class="message-box">
                            <p><%= chat.msg %></p>

                            <div class="card-actions">
                                <form method="GET" action="/chats/<%= chat._id %>/edit" class="edit-form">
                                    <button type="submit" class="edit-btn" title="Edit message">
                                        ✎ Edit
                                    </button>
                                </form>

                                <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE" class="delete-form" onsubmit="return confirm('Delete this message?');">
                                    <button type="submit" class="delete-btn" title="Delete message">
                                        🗑 Delete
                                    </button>
                                </form>
                            </div>
                        </div>


                        <!-- Footer -->
                        <div class="chat-footer">
                            <span class="recipient">
                                Received by <strong><%= chat.to %></strong>
                            </span>

                            <span class="message-status">
                                <span class="tick read">✓✓</span> Delivered
                            </span>
                        </div>

                    </article>

                <% } %>

            </div>

        </section>

    </main>

</body>
</html>